TYPE='XYZ FILE' VERSION='4' UNITS='US' SOURCE='TLCAD sample' USER='' FILENAME='grid.xyz'
; GRID example of the PLS-CADD manual, section 6.3: a 13-point symmetrical pyramid.
; Points 1-9 are at elevation 100 ft, point 5 at 300 ft, points 10-13 at 200 ft.
'1' 0 0 100 200 0
'2' 500 0 100 200 0
'3' 1000 0 100 200 0
'4' 0 500 100 200 0
'5' 500 500 300 200 0
'6' 1000 500 100 200 0
'7' 0 1000 100 200 0
'8' 500 1000 100 200 0
'9' 1000 1000 100 200 0
'10' 250 250 200 200 0
'11' 750 250 200 200 0
'12' 250 750 200 200 0
'13' 750 750 200 200 0
