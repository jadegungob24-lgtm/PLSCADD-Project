{
  "name": "tlcad",
  "private": true,
  "type": "module",
  "description": "Browser-based transmission line design platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tlcad/web",
    "build": "npm run build -w @tlcad/web",
    "preview": "npm run preview -w @tlcad/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
